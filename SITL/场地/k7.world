<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="cuadc_k7">
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ================================================================
         投放区域 — 8m 宽 (NED x, 左右) × 5m 纵深 (NED y, 前后)
         后端边距起飞点 30m (NED y=30), 前端边 NED y=35
         几何中心: NED (0, 32.5) → Gazebo (33.51, 0.98, 0)
         对称轴与飞机 heading0 方向 (纯东 = NED y+) 重合

         Gazebo 4 角坐标:
          后左 (NED -4, 30)  → (31.01, -3.02)
          后右 (NED +4, 30)  → (31.01,  4.98)
          前左 (NED -4, 35)  → (36.01, -3.02)
          前右 (NED +4, 35)  → (36.01,  4.98)

         侦察区域 — 8m 宽 × 5m 纵深, 距投放区远边 20m
         NED y: [55, 60], 中心 NED (0, 57.5) → Gazebo (58.51, 0.98)
         Gazebo 4 角坐标:
          后左 (NED -4, 55)  → (56.01, -3.02)
          后右 (NED +4, 55)  → (56.01,  4.98)
          前左 (NED -4, 60)  → (61.01, -3.02)
          前右 (NED +4, 60)  → (61.01,  4.98)
         ================================================================ -->

    <!-- ==================== 投放区 ==================== -->

    <!-- 后端框边 (NED y=30, Gazebo x=31.01) -->
    <model name="drop_border_back">
      <static>true</static>
      <pose>31.01 0.98 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 8.0 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 8.0 0.03</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 前端框边 (NED y=35, Gazebo x=36.01) -->
    <model name="drop_border_front">
      <static>true</static>
      <pose>36.01 0.98 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 8.0 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 8.0 0.03</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 左框边 (NED x=-4, Gazebo y=-3.02) -->
    <model name="drop_border_left">
      <static>true</static>
      <pose>33.51 -3.02 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.08 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.08 0.03</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 右框边 (NED x=+4, Gazebo y=4.98) -->
    <model name="drop_border_right">
      <static>true</static>
      <pose>33.51 4.98 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.08 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.08 0.03</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 投放区 4 角标 (橙色) -->
    <model name="drop_corner_bl"><static>true</static><pose>31.01 -3.02 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>1 0.6 0 1</ambient><diffuse>1 0.6 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drop_corner_br"><static>true</static><pose>31.01 4.98 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>1 0.6 0 1</ambient><diffuse>1 0.6 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drop_corner_fl"><static>true</static><pose>36.01 -3.02 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>1 0.6 0 1</ambient><diffuse>1 0.6 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drop_corner_fr"><static>true</static><pose>36.01 4.98 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>1 0.6 0 1</ambient><diffuse>1 0.6 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         3个靶桶 (固定分布, 半径 0.125m, 高 0.25m, 红色)
         位置均在投放区矩形范围内 (NED y ∈ [30, 35], NED x ∈ [-4, +4]):
          桶1 NED (-1.5, 31.5) → Gazebo (32.51, -0.52)
          桶2 NED ( 2.0, 33.0) → Gazebo (34.01,  2.98)
          桶3 NED ( 0.0, 34.0) → Gazebo (35.01,  0.98)
         ================================================================ -->




    <!-- ==================== 侦察区 (无目标物) ==================== -->

    <!-- 侦察区后端框边 (NED y=55, Gazebo x=56.01) -->
    <!-- ===== 投放桶 (规则: 直径 15/20/25cm, 高 30cm, 白色; 落桶内 A 区) ===== -->
    <model name="target_bucket_1">
      <static>true</static>
      <pose>31.843 2.021 0.150 0 0 0</pose>
      <link name="bucket_link">
        <collision name="bucket_collision">
          <geometry>
            <cylinder><radius>0.1250</radius><length>0.3000</length></cylinder>
          </geometry>
        </collision>

        <visual name="bucket_visual">
          <geometry>
            <cylinder><radius>0.1250</radius><length>0.3000</length></cylinder>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="bucket_rim">
          <pose>0 0 0.1500 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.1300</radius><length>0.012</length></cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
