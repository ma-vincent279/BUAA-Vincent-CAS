K_TRACKER_BLOCK = '''    def _update_trackers(self, bucket_ests):
        """2026-10-11 新 k: 检测↔追踪器改【一对一全局分配】 (复现 2026CUADC 的 merge_detections 语义)。

        为什么必须改 (SITL 实测, 2026-10-11 首轮): 旧写法对每个检测各自找"最近的追踪器",
        **没有一对一约束** ⇒ 两个相距 1.12m 的框 (< TRACKER_NED_MATCH = 1.5m) 被并进同一个
        追踪器, 追踪器停在两桶中间 NED(0.65,33.4), 而真桶在 (0.48,33.0) 与 (1.05,34.0)
        ⇒ "已确认目标"永远只有 1 个 ⇒ 选不出 2 桶 ⇒ HOVER_SEARCH 10s 超时直接飞侦察区,
        **0/0 投弹** (检测器每帧其实稳定报 2 框 w=17/14 —— 不是视觉问题)。
        规则对齐后桶在 5×8m 区内随机摆放、间距可能只有 1m 级, 所以这条修正是**必须的**。

        改法 = 他们的做法 (merge_detections): 先列出门限内所有 (追踪器, 检测) 候选对,
        按距离升序**贪心一对一** (每个追踪器与每个检测各用一次); 未被分配的检测才新建追踪器。
        """
        now = self.get_clock().now()
        now_s = now.nanoseconds * 1e-9

        # (1) 候选对 (距离升序)
        pairs = []
        for di, est in enumerate(bucket_ests):
            bx, by = float(est[0]), float(est[1])
            for t in self._trackers:
                dist = math.hypot(bx - t["ned"][0], by - t["ned"][1])
                if dist < TRACKER_NED_MATCH:
                    pairs.append((dist, di, t))
        pairs.sort(key=lambda p: p[0])

        # (2) 贪心一对一: 每个追踪器与每个检测只许用一次
        used_det, used_trk, assign = set(), set(), []
        for dist, di, t in pairs:
            if di in used_det or id(t) in used_trk:
                continue
            used_det.add(di)
            used_trk.add(id(t))
            assign.append((dist, di, t))
        assign.sort(key=lambda a: a[1])

        for dist, di, best_t in assign:
            bx, by, roi, _d, cx, cy = bucket_ests[di]
            if dist > 0.8:                       # 2026-09-20 诊断: 距离偏大的匹配
                self.get_logger().info(
                    f"  TRK-PULL #{self._trackers.index(best_t)} dist={dist:.2f}m "
                    f"box(cx={cx:.0f},cy={cy:.0f}) NED({bx:.2f},{by:.2f}) "
                    f"← tracker NED({best_t['ned'][0]:.2f},{best_t['ned'][1]:.2f})")
            alpha = 0.3
            old_x, old_y = best_t["ned"]
            best_t["ned"] = (old_x + alpha * (bx - old_x),
                             old_y + alpha * (by - old_y))
            best_t["last_seen"] = now_s
            best_t["roi_center"] = (cx, cy)
            best_t["area"] = float(roi.width * roi.height)
            if not best_t["confirmed"] and (now_s - best_t["first_seen"]) >= TRACKER_CONFIRM_TIME:
                best_t["confirmed"] = True
                self.get_logger().info(
