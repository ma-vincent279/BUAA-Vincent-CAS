        脏帧时沿用一个周期前的命令点, 与他们的 FINE_DESCENT_VISION_STALE 语义一致。
        """
        if roi is None:
            return False
        if not self._i_target_tracker_ok():
            return False
        return self._i_roi_inside(roi)

