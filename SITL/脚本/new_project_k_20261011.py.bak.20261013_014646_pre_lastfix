    def _k_bucket_diameter(self, tracker):
        """由追踪器记的检测框反推桶直径 (m)。

        GT/真实下视框都是圆的外接方框 ⇒ 边长 ≈ sqrt(area), 直径 D = 边长·depth/FX。
        用途有两个: ① 规则按直径计分 ⇒ 必须知道是 15/20/25cm 哪一档;
                     ② 同时是一次"测距自检" —— D 明显偏离三档就说明高度/平面错了。
        """
        try:
            side_px = math.sqrt(max(0.0, float(tracker.get("area", 0.0))))
        except (TypeError, ValueError):
            return None
        depth = (self.home_z - self.z) + K_TARGET_PLANE_H
        if not math.isfinite(depth) or depth <= 0.2:
            return None
        return side_px * depth / FX

    def _k_roi_usable(self, roi):
        """闭环更新只接受"干净帧": 追踪器已确认 + 框完全在画面内。

