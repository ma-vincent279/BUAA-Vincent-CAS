def replace_once(text, old, new, tag):
    """精确匹配优先; 失配时**回退为按代码匹配**。

    SITL 的 i.py 与板载 fly/src/fly/fly/i.py 之间有 452 行差异, 其中大量**只是注释不同**
    (例: "# ---- DROP ----" vs "# ---- DROP: 投弹 ----")。生成器现在也要能以板载 i.py
    为源生成板载 k.py ⇒ 精确锚点失配时, 把每行**行尾 # 之后的注释去掉**再正则匹配;
    仍要求**唯一命中**, 避免误替换。
    """
    n = text.count(old)
    if n == 1:
        return text.replace(old, new, 1)
    pat = []
    for line in old.split("\n"):
        code = line.split("#", 1)[0].rstrip()
        if code:
            pat.append(re.escape(code.strip()) + r"[ \t]*(?:#.*)?")
        else:
            pat.append(r"[ \t]*(?:#.*)?")
    rx = re.compile("(?m)^[ \t]*" + r"\n[ \t]*".join(pat) + r"[ \t]*$")
    hits = list(rx.finditer(text))
    assert len(hits) == 1, f"[{tag}] 精确 {n} 次 / 代码回退 {len(hits)} 次 (要求 1 次)"
    m = hits[0]
    return text[:m.start()] + new.rstrip("\n") + text[m.end():]


CAM_OLD = 'IMG_W, IMG_H = 640, 360\nCX, CY = IMG_W / 2.0, IMG_H / 2.0\nHFOV = math.radians(85)\nVFOV = math.radians(54)\nFX = IMG_W / (2.0 * math.tan(HFOV / 2.0))\nFY = IMG_H / (2.0 * math.tan(VFOV / 2.0))\n'

CAM_NEW = '# ===== D25 (2026-10-12): 相机模型改为「原生画幅」, 去掉视觉裁切 =====\n# 硬件: **单目 / 无畸变 / 对角线视角 130° / 画幅 16:9**。\n# 旧方案用一个**更窄的等效视场** (HFOV 85° / VFOV 54°) 描述同一张 640x360 图 —— 等价于只用\n# 原生画幅中心 tan(42.5°)/tan(61.85°) ≈ 49% 的宽度 (即"裁切")。本版直接用原生画幅:\n#   焦距由**对角线**视角反解 (方形像素 ⇒ FX = FY = f):\n#     f = (d_px/2)/tan(DIAG_FOV/2),  d_px = hypot(IMG_W,IMG_H) = 734.30 px\n#     f = 367.15 / tan(65°) = 171.21 px\n#   ⇒ HFOV = 2·atan(320/f) = 123.71°,  VFOV = 2·atan(180/f) = 92.87°\n# ⚠ 与旧值相比焦距缩小 2.04× ⇒ 同一像素偏差算出的地面偏移**翻倍**; 旧的实飞补偿\n#   Y_B1/Y_B2/XF 是在旧模型下标定的 ⇒ **必须同时归零** (见 D26)。\nDIAG_FOV_DEG = 130.0                       # 硬件对角线视角 (原生画幅)\nIMG_W, IMG_H = 640, 360                    # 16:9 (see.py 把 1920x1080 整幅 resize 到此)\nCX, CY = IMG_W / 2.0, IMG_H / 2.0\nFOCAL_PX = (math.hypot(IMG_W, IMG_H) / 2.0) / math.tan(math.radians(DIAG_FOV_DEG) / 2.0)\nFX = FY = FOCAL_PX                         # 方形像素 ⇒ 同一焦距\nHFOV = 2.0 * math.atan(IMG_W / 2.0 / FX)   # 123.71°\nVFOV = 2.0 * math.atan(IMG_H / 2.0 / FY)   # 92.87°\n'


def build(src_text: str) -> str:
    t = src_text

    # ---- D1: 头部 ----
    first_nl = t.index("\n")
    t = HEADER + t[first_nl + 1:]
    t = replace_once(t, "class IMission(Node):", "class KMission(Node):", "D1-class")
    t = replace_once(t, "super().__init__('i_mission')",
                     "super().__init__('k_mission')", "D1-node")
    t = replace_once(t, 'MISSION_REVISION = "competition-water-20260924-r1-f-i"',
                     'MISSION_REVISION = "cuadc-20261011-r1-k-servo"', "D1-rev")
    t = replace_once(t, "    node = IMission()", "    node = KMission()", "D1-main")

    # ---- D2: 常量块 (插在 I_RELEASE_TIMEOUT 之后) ----
    anchor2 = ("I_RELEASE_TIMEOUT = 20.0   # 从进 DROP 起的兜底 (s): "
               "超时无论有没有检测都强制投放 (必投)\n")
    t = replace_once(t, anchor2, anchor2 + K_CONSTANTS, "D2-consts")
    # MISSION_REVISION 现在有两行 (i 的原值与常量块插入后) —— 检查只剩一行
    assert t.count("MISSION_REVISION = ") == 1, "MISSION_REVISION 出现多行"

    # ---- D3: /drop/impact_rel 发布器 ----
    anchor3 = ("        self.impact_pub = self.create_publisher(Point, "
               "'/drop/impact_point', 10)\n")
    t = replace_once(t, anchor3,
                     anchor3 + ("        # 2026-10-11 新 k: 相对 home 的落点 "
                                "(与 worlds/*.truth.json 同系, 供 cuadc_judge)\n"
                                "        self.impact_rel_pub = self.create_publisher("
                                "Point, '/drop/impact_rel', 10)\n"),
                     "D3-pub")

    # ---- D4: 辅助方法 (插在 _roi_to_ned 之前) ----
    anchor4 = "    def _roi_to_ned(self, roi):\n"
    t = replace_once(t, anchor4, K_METHODS + anchor4, "D4-methods")

    # ---- D5: DROP 段整体替换 ----
    # ⚠ 板载 i.py 的注释多一个后缀 ("# ---- DROP: 投弹 ----") ⇒ 两种都接受
    _begs = ["        # ---- DROP ----\n        elif self.step == STEP_DROP:\n",
             "        # ---- DROP: 投弹 ----\n        elif self.step == STEP_DROP:\n"]
    beg_marker = next((b for b in _begs if b in t), None)
    assert beg_marker is not None, "DROP 段起始标记两种写法都没找到"
    end_marker = "\n        # ---- CLIMB: 投弹后爬升"
    i0 = t.index(beg_marker)
    i1 = t.index(end_marker)
    assert i0 < i1, "DROP 段定位失败"
    t = t[:i0] + K_DROP_BLOCK + t[i1 + 1:]

    # ---- D6: 选桶排序 ----
    t = replace_once(t, K_SELECT_OLD, K_SELECT_NEW, "D6-select")

    # ---- D9: FORWARD_DIST → 投放区几何中心 ----
    # ⚠ SITL/板载 i.py 的**注释文字不同**, 只按代码部分匹配那一整行
    _m9 = re.search(r"(?m)^FORWARD_DIST\s*=\s*34\.0.*$", t)
    assert _m9, "[D9-forward] 找不到 FORWARD_DIST = 34.0 行"
    t = t.replace(_m9.group(0),
                  "FORWARD_DIST  = 32.5      # 2026-10-11 新 k (D9): 34→32.5 = **投放区几何中心**"
                  " (规则: 桶可摆在 NED y∈[30,35] 任意处; 5m 悬停视野只 ±2.8m ⇒ 34 会漏掉 y<31.2 的桶)",
                  1) + K_SEARCH_POINT_NOTE

    # ---- D10: 选桶门 ----
    t = replace_once(t, K_SELECT_GATE_OLD, K_SELECT_GATE_NEW, "D10-select-gate")
    # D13: 选桶时记下选中桶的直径 (DROP 段据此算释放容差)
    t = replace_once(
        t, '            selected = [(t["ned"][0], t["ned"][1]) for t in picked]\n',
        '            selected = [(t["ned"][0], t["ned"][1]) for t in picked]\n'
        '            self._target_diams = [_dia[id(t)] for t in picked]'
        '   # D13: 选中的桶径 (释放容差用)\n', "D13-diams")

    # ---- D21: 飞控状态 + EKF 健康度观测字段 (只读; 复用既有补丁的锚点与文本, 单一来源) ----
    import importlib.util as _ilu
    _spec = _ilu.spec_from_file_location(
        "_ekfpatch", REPO / "scripts" / "patch_ekf_tlm_20261009.py")
    _mod = _ilu.module_from_spec(_spec)
    _spec.loader.exec_module(_mod)
    t = replace_once(t, _mod.A_ANCHOR, _mod.A_ANCHOR + _mod.A_INSERT, "D21-A")
    t = replace_once(t, _mod.B_ANCHOR, _mod.B_ANCHOR + _mod.B_INSERT, "D21-B")
    t = replace_once(t, _mod.C_ANCHOR, _mod.C_REPLACE, "D21-C")

    # ---- D28: 残缺框过滤下限 8px → 3px (D25 换广角后 5m 处桶只有 ~5px) ----
    t = replace_once(t, "            _thr = max(8.0, 0.5 * sides[len(sides) // 2])",
                        "            _thr = max(K_ROI_MIN_PX, 0.5 * sides[len(sides) // 2])  # D28", "D28-a")
    t = replace_once(t, "            _thr = 8.0\n", "            _thr = K_ROI_MIN_PX  # D28\n", "D28-b")

    # ---- D29: 巡航高度 5.0 → 3.0 m; 同时把「PID 增益基准」拆出来 ----
    #   为什么可以降到 3m (2026-10-12 算过): 相机换成原生 130° 后
    #     沿机头方向覆盖 = 2·H·tan(92.87°/2) ⇒ 3m 时 6.31m > 投放区 5m ✓ (2.5m 也够: 5.26m)
    #     横向覆盖 = 2·H·tan(123.70°/2) ⇒ 3m 时 11.21m > 区宽 8m ✓
    #   ⇒ **一次进场就能看全整个投放区**(旧 85°/54° 在 3m 只覆盖 3.06m, 所以当年才定 5m)。
    #   好处: 15cm 桶成像从 5.1px(5m) 升到 **8.6px(3m)** ⇒ 直径分类量化误差从 ±2cm 降到 ±0.9cm。
    #   ⚠ `CRUISE_HEIGHT` 同时是伺服 PID 的增益基准 (`height_scale = H/CRUISE_HEIGHT`),
    #     直接改会让同一高度下的增益放大 5/3=1.67× ⇒ 必须拆出 `PID_HEIGHT_REF` 固定在 5.0。
    t = replace_once(t, "CRUISE_HEIGHT = 5.0\n",
        "CRUISE_HEIGHT = 3.0    # D29: 巡航/搜索高度 (m) —— 5.0→3.0 (130° 视野下 3m 已能看全投放区)\n"
        "PID_HEIGHT_REF = 5.0   # D29: 伺服 PID 的**增益基准高度** (m) —— 与巡航高度解耦, 保持 5.0 不变\n",
        "D29-alt")
    # ⚠ 缩进在 SITL/板载 i.py 里不同 (16 vs 20 空格) ⇒ 保留原行缩进
    _m32 = re.search(r"(?m)^([ \t]*)height_scale = dz_h / CRUISE_HEIGHT.*$", t)
    assert _m32, "[D32] height_scale 锚点未命中"
    _ind = _m32.group(1)
    t = t.replace(_m32.group(0),
                  f"{_ind}# D32 (2026-10-13, 用户要求): **关闭按高度比例增益** —— 他们没有\n"
                  f"{_ind}# 像素 PID / 高度缩放 (全库无 height_scale), 先用固定增益与他们对齐。\n"
                  f"{_ind}height_scale = 1.0", 1)
    t = replace_once(t, "            f\"cruise={CRUISE_HEIGHT}m drop={DROP_HEIGHT}m (no flight boundary)\")",
                        "            f\"cruise={CRUISE_HEIGHT}m drop={DROP_HEIGHT}m (no flight boundary)\")", "D29-log-noop")

    # ---- D25: 相机模型换成原生 130° 对角线 @16:9 (去视觉裁切) ----
    t = replace_once(t, CAM_OLD, CAM_NEW, "D25-camera")

    # ---- D16a: _cb_detect 记录检测帧序号 (供 DROP 段判"这一拍是不是新帧") ----
    t = replace_once(
        t, '        detections = data.get("buckets", [])\n',
        '        detections = data.get("buckets", [])\n'
        '        self._det_seq = data.get("frame_seq")   # D16: 新帧判据用 (检测器 10Hz, 节点 20Hz)\n',
        "D16a-seq")

    # ---- D13: 释放容差 = 桶半径 × 0.8 ----
    anchor13 = "K_SIM_IDEAL_CAMERA = True"
    t = replace_once(t, anchor13, K_TOL_CONST + anchor13, "D13-consts")
    t = replace_once(t, K_TOL_OLD, K_TOL_NEW, "D13-init")
    for _o, _n in K_TOL_USE:
        t = replace_once(t, _o, _n, "D13-use")

    # ---- D12: 下降段改时间锚定限速 ----
    t = replace_once(t, K_DESCENT_OLD_PRE, K_DESCENT_NEW_PRE, "D12-pre")
    t = replace_once(t, K_DESCENT_OLD_VIS, K_DESCENT_NEW_VIS, "D12-vis")

    # ---- D8: 追踪器改一对一全局分配 ----
    tb = t.index("    def _update_trackers(self, bucket_ests):\n")
    te = t.index("\n    def _enter_step(self, step):\n")
    assert tb < te, "追踪器函数定位失败"
    t = t[:tb] + K_TRACKER_BLOCK + t[te + 1:]

    return t


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true", help="只校验锚点, 不写文件")
    ap.add_argument("--diff", action="store_true", help="打印与 i 的差异块")
    ap.add_argument("--src", default=None, help="源文件 (默认 SITL 的 i.py; 板载版传 fly 的 i.py)")
    ap.add_argument("--dst", default=None, help="输出文件 (默认 SITL 的 k.py; 板载版传 fly 的 k.py)")
    args = ap.parse_args()

    src_path = pathlib.Path(args.src) if args.src else SRC
    dst_path = pathlib.Path(args.dst) if args.dst else DST
    src = src_path.read_text(encoding="utf-8")
    out = build(src)

    if args.check:
        print("锚点全部命中 ✓")
    if args.diff:
        a = src.split("\n")
        b = out.split("\n")
        sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
        blocks = [op for op in sm.get_opcodes() if op[0] != "equal"]
        print(f"i.py {len(a)} 行 → k.py {len(b)} 行, 差异块 {len(blocks)} 处:")
        for tag, i1, i2, j1, j2 in blocks:
            print(f"  {tag:8s} i[{i1 + 1}:{i2}] ({i2 - i1} 行) → k[{j1 + 1}:{j2}] ({j2 - j1} 行)")
        return 0
    if args.check:
        return 0

    if dst_path.exists():
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        bak = dst_path.with_suffix(f".py.bak.{ts}_newk")
        shutil.copy2(DST, bak)
        print(f"[backup] {bak.name}")
    dst_path.write_text(out, encoding="utf-8")
    print(f"[write] {DST.relative_to(REPO)}  {len(out.splitlines())} 行 "
          f"({DST.stat().st_size} B)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
