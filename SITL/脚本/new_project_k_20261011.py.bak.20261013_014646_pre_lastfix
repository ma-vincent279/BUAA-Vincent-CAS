K_SELECT_NEW = """            s_h0 = math.sin(self._heading0) if self._heading0 is not None else 0.0
            c_h0 = math.cos(self._heading0) if self._heading0 is not None else 0.0
            # 2026-10-11 新 k: **规则计分 ⇒ 目标是直径最小的两个桶**
            #   (15cm = 500 分 / 20cm = 300 分 / 25cm = 100 分; 抛弃只值 100 分的那个)
            #   i 时代是"面积降序取大的两个", 在一个"三桶同径"的仿真里定的 ⇒ 与规则相反。
