            # ---- D16b: 只在**新检测帧**上更新设定点 ----
            #   为什么: 检测器 10Hz 出新帧, 节点 20Hz 跑控制 ⇒ 约一半的拍子拿的是
            #   50~100ms 前的旧像素, 却配上**当前**位姿去反投影 ⇒
            #       err_旧帧 = (桶 − 飞机(t−延迟)) − 补偿
            #       aim = 飞机(t) + err_旧帧 = 桶 − 补偿 + (飞机(t) − 飞机(t−延迟))
            #   最后那一项 = 飞机自己在延迟内的位移 ⇒ **设定点被拽向飞机自己的运动方向**
            #   (负阻尼/正反馈)。这正是他们 `navigation_sample_at(stamp)`(按曝光时刻插值位姿)
            #   要治的项 —— 这里用最小可行版: 新帧才算, 旧帧**只发设定点不动目标**。
            _seq = getattr(self, '_det_seq', None)
            _is_new_frame = (_seq is not None and _seq != getattr(self, '_k_last_seq', None))
            if _is_new_frame:
                self._k_n_new += 1
            else:
                self._k_n_stale += 1
            if _is_new_frame and _age <= K_AGE_MAX and self._k_roi_usable(_roi):
                self._k_last_seq = _seq
                _cx = _roi.x_offset + _roi.width / 2.0
                _cy = _roi.y_offset + _roi.height / 2.0
                _proj = camera_pixel_to_level(_cx, _cy, self._pitch, self._roll)
                if _proj is not None:
                    _H = self.home_z - self.z
                    _depth = _H + K_TARGET_PLANE_H
                    if _depth > 0.2:
                        _rim_fwd = _proj[0] * _depth        # 桶相对飞机: 机体前
                        _rim_right = _proj[1] * _depth      # 桶相对飞机: 机体右
                        # 期望: 桶应停在机体 (前, 右) = (XF, Y) 处
                        _err_fwd = _rim_fwd - self._k_comp_xf
                        _err_right = _rim_right - self._k_comp_y
                        self._k_resid = math.hypot(_err_fwd, _err_right)
                        self._k_err = (_err_fwd, _err_right)   # D15: 预测落点判据用
                        self._k_H = _H                          # D15
                        self._k_resid_t = _now                  # D24: 残差的时间戳
                        _dx, _dy, _ = self._body_to_ned(_err_fwd, _err_right)
                        # ---- D14: 设定点积分 (有界) ----
                        # 为什么必须有: 我们的设定点 = **桶估计 − 两瓶补偿**, 与飞机自身位置**无关**
                        #   ⇒ "飞机相对设定点的偏差" 完全由飞控位置环决定, 闭环**结构上无权**修正它。
                        #   SITL 实测 (7 轮): 第 1 投设定点稳定在 (+2.20,+31.62), 飞机却停在
                        #   (+2.40,+31.6), **20cm 稳态偏差 8 秒不收敛** ⇒ 只能走必投兜底。
                        #   加一个有界积分项, 让设定点朝残差方向持续追赶, 直到**真实**站位到位
                        #   (平衡点仍是"残差=0 ⇔ 真实站位 = 桶 − 补偿", 只是把飞控的稳态误差补掉)。
                        #   ⚠ 这是**超出他们做法**的一处新增 (ArduPilot 位置环没有这个稳态误差, 他们不需要);
                        #     上限 0.40m 是安全闸, 视觉失效时不积分。
                        self._k_bias_x += K_AIM_KI * _dx * _dt
                        self._k_bias_y += K_AIM_KI * _dy * _dt
                        _bn = math.hypot(self._k_bias_x, self._k_bias_y)
                        if _bn > K_AIM_BIAS_MAX:
                            self._k_bias_x *= K_AIM_BIAS_MAX / _bn
                            self._k_bias_y *= K_AIM_BIAS_MAX / _bn
                        _target = (self.x + _dx + self._k_bias_x,
                                   self.y + _dy + self._k_bias_y)
                        self._k_frozen_aim = _target
                        self._k_n_upd += 1
            if _target is None:
                self._k_n_rej += 1
                self._k_resid = None
                self._k_err = None                # D15: 脏帧不参与预测判据
                self._k_resid_t = None            # D24: 残差失效
                _target = self._k_frozen_aim if self._k_frozen_aim else (self.x, self.y)

            # (5) 设定点限速 (他们的 rate_limited_drop_target 语义): 命令点朝新目标走
            _ax, _ay = self._k_aim
            _ddx, _ddy = _target[0] - _ax, _target[1] - _ay
            _dd = math.hypot(_ddx, _ddy)
            _step_max = K_VMAX_DROP * min(_dt, K_DT_CLAMP)
            if _dd > _step_max and _dd > 1e-9:
                _ax += _ddx / _dd * _step_max
                _ay += _ddy / _dd * _step_max
            else:
                _ax, _ay = _target
            self._k_aim = (_ax, _ay)
            self._pub_pos(_ax, _ay, drop_z, self.heading)

            # (6) 释放判据 = 同一个残差的模 (残差即"投放口离桶口多远")
            _elapsed = (_now - self._k_start).nanoseconds * 1e-9
            _vxy = math.hypot(self.vx, self.vy)
            _tol = K_RELEASE_M
            if self._k_arrive is not None:
                _win = (_now - self._k_arrive).nanoseconds * 1e-9
                if _win >= K_WINDOW_S:
                    _tol = K_WINDOW_RELAX_M
            else:
                _win = 0.0

            _h_ok = self.z > drop_z - 0.2
            # D24: 残差新鲜度 —— 过时残差不参与判据 (旧帧拍子上 `_k_resid` 不动, 但飞机在动)
            _resid_fresh = (self._k_resid_t is not None
                            and (_now - self._k_resid_t).nanoseconds * 1e-9 <= K_RESID_MAX_AGE)
            _resid_now = self._k_resid if _resid_fresh else None
            # ---- D15: 释放判据改用**预测落点** (机体系) ----
            #   物理: 载荷从 H 落下需 t_fall = sqrt(2H/g) ≈ 0.5s, 期间飞机还在以 v 移动
            #         ⇒ 真实落点 = 瞄准点 + v·t_fall ⇒ 该看 pred = |err − v_body·t_fall|。
            #   为什么必须 (SITL 第 8 轮实测): 老判据要求 |err| ≤ 容差 **且** |vxy| ≤ 0.15
            #         两件事同时成立 —— 第 1 投残差已到 7.5cm (容差 5.9/8.9cm), 却被
            #         vxy=0.272 一票否决 ⇒ 只能走必投兜底。而"正朝桶飞过去"的那一瞬
            #         恰恰是**最好**的释放时机。
            #   这是项目自己验证过的 `pred` 思想, 这里只把量搬到机体系 (对 EKF 漂移免疫)。
            _t_fall = math.sqrt(max(0.0, 2.0 * drop_zone_H / K_FALL_G))
            _ch2, _sh2 = math.cos(self.heading), math.sin(self.heading)
            _v_fwd = self.vx * _ch2 + self.vy * _sh2
            _v_rgt = -self.vx * _sh2 + self.vy * _ch2
            self._k_pred = None
            if self._k_err is not None and self._k_resid is not None:
                self._k_pred = math.hypot(self._k_err[0] - _v_fwd * _t_fall,
                                          self._k_err[1] - _v_rgt * _t_fall)
            # D15b (2026-10-11 第 9 轮实测后修正): 必须是**合取** ——
            #   pred 只用得着「释放瞬间的速度」, 而这台机悬停时有 ~1s 周期的极限环
            #   (位置 ±10~25cm / 速度 ±0.25m/s)。第 9 轮实测: 只看 pred 时两投都在
            #   pred=6.1/7.9cm 放行, 但**实际落点 18.5/17.2cm** —— 半个周期后速度反向,
            #   「正朝桶飞」的预测当场失效。⇒ 位置与预测**同时**满足才放行。
            _tol_resid = K_RESID_MAX_FACTOR * _tol
            _tier = None
            if K_SIM_NO_BALLISTIC:
                # D20 SITL 路径: 落点 = 释放瞬间站位 ⇒ **只判残差** (速度/弹道项一律不参与)
                _ok_gate = (_resid_now is not None and _resid_now <= _tol)
            elif K_USE_PRED_RELEASE:
                _ok_gate = (self._k_pred is not None and self._k_pred <= _tol
                            and _resid_now is not None and _resid_now <= _tol_resid)
            else:
                # 实机路径: 残差 + 准静止 (物理依据: 落 0.495s, 0.15m/s ⇒ 漂 7.4cm ≈ 小桶半径)
                _ok_gate = (_resid_now is not None and _resid_now <= _tol
                            and _vxy <= K_VXY_REL)
            # ---- D30 (2026-10-13, 精读他们代码后的**自我更正**) ----
            #   他们 `update_release()` 的真实逻辑 (cuadc_full_mission_node.cpp:3400~3435):
            #     ① 先到释放平面 (|z − frozen.z| ≤ 0.05) 才开始计时;
            #     ② **任一时刻** `visual_error ≤ release_visual_xy_tolerance(0.03)` ⇒ **立刻发释放**
            #        (日志 INFO "VISUAL_RELEASE_TOLERANCE");
            #     ③ 到 `release_stabilization_s(2.0)` 仍未达标 ⇒ **强制释放**
            #        (日志 WARN "VISUAL_RELEASE_TIMEOUT ... forcing release")。
            #   ⇒ **2.0s 是超时兜底, 不是"连续达标 2 秒"的确认窗**。
            #   我们原先实现成「≤容差 且 连续保持 2.00s」—— 比他们**更严**, 白白错过好机会。
            #   达标 ⇒ 立刻放行; 到释放平面 2.0s 仍未达标 ⇒ 强制放行 (他们同款)
            if _ok_gate and (K_SIM_NO_BALLISTIC or _vxy <= K_VXY_SAFE) and _h_ok:
                _tier = 1 if _tol <= K_RELEASE_M else 2
            elif (self._k_arrive is not None and _h_ok
                  and (_now - self._k_arrive).nanoseconds * 1e-9 >= K_RELEASE_CONFIRM):
                _tier = 3
            self._k_ok_since = _now if _tier is not None else None
            _deadline = _elapsed >= K_DEADLINE_S

            # (7) 节流日志
            if (_now - self._k_last_log).nanoseconds * 1e-9 >= K_LOG_EVERY:
                self._k_last_log = _now
                _rs = f"{self._k_resid * 100:5.1f}cm" if self._k_resid is not None else "  --  "
                self.get_logger().info(
                    f"  [K-SERVO] t={_elapsed:4.1f}s win={_win:3.1f}s H={self.home_z - self.z:4.2f}m "
                    f"残差={_rs} 门限={_tol * 100:.0f}cm vxy={_vxy:.3f} "
                    f"更新={self._k_n_upd}/拒绝={self._k_n_rej} 命令点=({_ax:+0.2f},{_ay:+0.2f}) "
                    f"积分偏置={math.hypot(self._k_bias_x, self._k_bias_y) * 100:.1f}cm "
                    f"pred={'--' if self._k_pred is None else f'{self._k_pred * 100:.1f}cm'} "
                    f"新帧={self._k_n_new}/旧帧跳过={self._k_n_stale}")

            if _tier is None and not _deadline:
                return

            # (8) 释放
            if _tier in (1, 2):
                _way = f"机体残差{self._k_resid * 100:.1f}cm<={_tol * 100:.0f}cm 达标即投"
            elif _tier == 3:
                _way = (f"释放平面后{K_RELEASE_CONFIRM:.1f}s 超时强制投 "
                        f"(他们的 VISUAL_RELEASE_TIMEOUT)")
            else:
                _way = f"{K_DEADLINE_S:.0f}s 必投兜底"
            if _tier is None:
                self.get_logger().warn(
                    f"[K-SERVO] {K_DEADLINE_S:.0f}s 兜底释放 (残差="
                    f"{'--' if self._k_resid is None else f'{self._k_resid * 100:.1f}cm'} "
                    f"vxy={_vxy:.3f} 更新={self._k_n_upd} 拒绝={self._k_n_rej})")
            if not self._drop_triggered:
                self._drop_triggered = True
                self._drop_signal_start = _now
                _sx, _sy = (self._current_target_ned if self._current_target_ned
                            else (self.x - self.home_x, self.y - self.home_y))
                self._served_targets.append((_sx, _sy))
                self.get_logger().info(
                    f"  SERVED +1 bucket NED({_sx:.2f},{_sy:.2f}) → 共 {len(self._served_targets)} 个已投")
                self._drop_hold_target = (_ax, _ay, drop_z, self.heading)
                _drop_val = AUX5_DROP if self._drop_count == 0 else AUX5_DROP2
                _pwm_us = 1500 + _drop_val * 600
                self._aux5_value = _drop_val
                self._drop_count += 1
                self.impact_pub.publish(Point(x=float(self.x), y=float(self.y),
                                              z=float(self.home_z)))
                # 新增: 相对 home 的落点 (与 worlds/*.truth.json 同系, 供 cuadc_judge)
                self.impact_rel_pub.publish(Point(x=float(self.x - self.home_x),
                                                  y=float(self.y - self.home_y),
                                                  z=float(self.home_z - self.z)))
                self._drop_records.append({
                    "idx": self._drop_count - 1,
                    "aim": (_ax, _ay),
                    "bucket": (_sx, _sy),
                    "pos": (self.x, self.y),
                    "H": self.home_z - self.z,
                    "tier": _tier,
                    "resid_m": self._k_resid,
                    "elapsed_s": _elapsed,
                    "n_upd": self._k_n_upd,
                    "n_rej": self._k_n_rej,
                })
                self.get_logger().info(
                    f">>> DROP #{self._drop_count - 1}! PWM={_pwm_us:.0f}us "
                    f"NED({self.x:.3f},{self.y:.3f},{self.z:.3f}) "
                    f"桶NED({_sx:+.3f},{_sy:+.3f}) 落点相对home=({self.x - self.home_x:+.3f},"
                    f"{self.y - self.home_y:+.3f}) "
                    f"pitch={self._pitch:+.3f} roll={self._roll:+.3f} vxy={_vxy:.3f}m/s "
                    f"残差={'--' if self._k_resid is None else f'{self._k_resid * 100:.1f}cm'} "
                    f"pred={'--' if self._k_pred is None else f'{self._k_pred * 100:.1f}cm'} "
                    f"更新={self._k_n_upd} 拒绝={self._k_n_rej} "
                    f"新帧={self._k_n_new}/旧帧跳过={self._k_n_stale} "
                    f"event=release_command 触发方式={_way}")
            return

'''

