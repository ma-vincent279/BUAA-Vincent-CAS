def allowed_add(line):
    s = line.strip()
    if not s:
        return True
    if any(s.startswith(p) or s == p for p in ADD_ALLOW):
        return True
    # FC/EKF 构建块 (含续行) —— 用语义前缀而不是整行, 但对每条都限定在"格式化/告警"范围内
    pats = (
        r"^_st = self\.status$", r"^if _st is None:$", r"^else:$",
        r"^fc_str = \(f\" FC\(a", r"^f\" fs\{1 if bool\(getattr\(_st, 'failsafe'",
        r"^f\" d\{int\(getattr\(_st, 'latest_disarming_reason'", r"^_ek = self\._ekf$",
        r"^if _ek is None:$", r"^_dbt = \"--\" if _ek\[9\] is None else",
        r"^ek_str = \(f\" EKF\(", r"^f\" dr\{int\(_ek\[4\]\)\} rst",
        r"^if \(\(not _ek\[1\]\) or \(not _ek\[3\]\) or _ek\[4\]\):$",
        r"^_now_s = self\.get_clock\(\)\.now\(\)\.nanoseconds \* 1e-9$",
        r"^if _now_s - self\._ekf_warn_t > 5\.0:$", r"^self\._ekf_warn_t = _now_s$",
        r"^self\.get_logger\(\)\.warn\($", r"^f\"⚠ EKF 垂向估计不可信",
        r"^f\" v_z_valid=", r"^f\" z_reset=",
        r'^self\.get_logger\(\)\.info\($', r'^f"\[t=\{t_mission:7\.1f\}',
        r'^f"NED\(\{self\.x:7\.2f\}', r'^f"hdg=\{hdg:6\.1f\}',
        r'^f"vNED=\(\{self\.vx:\+\.2f\}',
        r'^f"\{has_det\} age=\{det_age:4\.2f\}\{extra\}\{fc_str\}\{ek_str\}"\)$',
    )
    return any(re.match(p, s) for p in pats)


def section_a():
    print("\n[A] 最小改动审计 — 只加观测, 控制分支零改动")
    for f in ALL:
        bak = latest_bak(f)
        if not check(bak is not None, f"{f.name}: 找到补丁前备份 ({BAK_GLOB})"):
            continue
        a, b = strip_comments(bak), strip_comments(f)
        sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
        added, removed, bad, later = [], [], [], []
        for tag, i1, i2, j1, j2 in sm.get_opcodes():
            if tag == "equal":
                continue
            # **块级**后续补丁归因 (续行/多行 f-string 不带关键字, 逐行匹配会漏;
            # 与 test_l_target_plane 的块级匹配同一套做法)
            if any(mk in "\n".join(b[j1:j2] + a[i1:i2]) for mk in LATER_PATCH_MARKERS):
                later.extend(b[j1:j2])
                continue
            if tag in ("insert", "replace"):
                for ln in b[j1:j2]:
                    added.append(ln)
                    if not allowed_add(ln):
                        bad.append("+" + ln)
            if tag in ("delete", "replace"):
                for ln in a[i1:i2]:
                    removed.append(ln)
                    if not any(ln.strip() == p for p in DEL_ALLOW):
                        bad.append("-" + ln)
        check(not bad, f"{f.name}: {len(added)} 新增行 / {len(removed)} 删除行 全部在允许集合内"
                       + ("" if not bad else f" (越界 {bad[:2]})"))
        if later:
            # 后续补丁**允许**改指令/发 setpoint (5m 巡航剖面就是要改下降指令) ——
            # 但**不许**偷偷改状态机跳转/换发布器; 指令类改动由各自验收脚本负责审计。
            check(not any(mk in "\n".join(later) for mk in
                          ("self.step =", "_enter_step(STEP_", "create_publisher")),
                  f"{f.name}: {len(later)} 行归因于后续补丁 且不含状态机跳转/发布器改动")
        if f is L_PY or f is L_FLY:
            check(not later, f"{f.name}: 无后续补丁行 (视觉门修复只该落在 k 上)")
        # 删除行只能来自 1Hz 调用 (8 行), 且新增行里必须出现新的日志行
        check(len(removed) <= 8 and any("fc_str}{ek_str}" in x for x in added),
              f"{f.name}: 删除 {len(removed)} 行 (≤8) 且新增了含 {{{{fc_str}}{{ek_str}}}} 的日志行")
        # 控制关键字绝不能被碰
        critical = ("_pub_pos", "_pub_vel", "STEP_VISUAL_SERVO", "STEP_DROP", "def _tick",
                    "arm(", "set_mode", "RELEASE", "_roi_to_ned", "_body_ok", "L_BODY_GATE_M")
        touched = [c for c in critical if any(c in ln and ln.strip().startswith(("+", "-")) for ln in bad)]
        check(not touched, f"{f.name}: 未触碰任何控制关键字 ({len(critical)} 个候选)")


LP_MARK = "# 2026-10-09: EKF 健康度快照 —— 0~3 有效性"   # 只出现在 _cb_local, 与 __init__ 的注释区分
FC_MARK = "# ===== 2026-10-09: 飞控状态 + EKF 健康度"


def _block(src, mark, endmark):
    """抽出从 mark 行首到 endmark 之前的整块 (含行首缩进, 便于 dedent 与逐字节比较)"""
    i = src.index(mark)
    i = src.rindex("\n", 0, i) + 1
    j = src.index(endmark, i)
    return src[i:j]


def _block_lp(src):
    """_cb_local 里插入的 EKF 快照语句 (注释 + 一条多行赋值), 精确到语句本身"""
    i = src.index(LP_MARK)
    i = src.rindex("\n", 0, i) + 1
    e = src.index("(float(m.dist_bottom) if bool(m.dist_bottom_valid) else None))", i)
    return src[i:src.index("\n", e) + 1]


