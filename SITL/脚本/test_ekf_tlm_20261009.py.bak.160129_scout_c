BAK_GLOB = "*_ekf_tlm"

n_pass = n_fail = 0


def check(cond, msg):
    global n_pass, n_fail
    if cond:
        n_pass += 1
        print(f"  ✓ {msg}")
    else:
        n_fail += 1
        print(f"  ✗ {msg}")
    return bool(cond)


def strip_comments(path):
    out = []
    for ln in path.read_text(encoding="utf-8").splitlines():
        s = ln.strip()
        if s.startswith("#"):
            continue
        out.append(ln.rstrip())
    return out


def latest_bak(path):
    c = sorted(glob.glob(str(path) + "." + BAK_GLOB))
    return pathlib.Path(c[-1]) if c else None


# 允许出现的新增行 (剥注释后)。**任何未列出的新增行 = 越界**
ADD_ALLOW = (
    # _cb_local 的 EKF 快照 (5 行)
    "self._ekf = (bool(m.xy_valid), bool(m.z_valid), bool(m.v_xy_valid), bool(m.v_z_valid),",
