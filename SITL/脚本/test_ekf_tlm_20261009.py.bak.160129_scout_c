# ── 真代码路径: 从 k.py 抽出补丁块并执行 ────────────────────────────────────
class _Log:
    def __init__(self): self.warns = []

    def warn(self, m): self.warns.append(m)

    def info(self, m): pass


class _Clock:
    def __init__(self, t): self.t = t

    def now(self): return types.SimpleNamespace(nanoseconds=int(self.t * 1e9))


class _Self:
    def __init__(self, t=0.0):
        self.status = None
        self._ekf = None
        self._ekf_warn_t = 0.0
        self._log = _Log()
        self.t = t
        self.landed = False   # 2026-10-09: 1Hz 行 FC 串追加的 landed 标志

    def get_logger(self): return self._log

    def get_clock(self): return _Clock(self.t)


def _extract_code():
    src = K_PY.read_text(encoding="utf-8")
    fc_block = textwrap.dedent(_block(src, FC_MARK,
                                      "self.get_logger().info("))
    lp_block = textwrap.dedent(_block_lp(src)).rstrip()
    return fc_block, lp_block


def _run_lp(lp_block, m):
    st = _Self()
    exec(lp_block, {"self": st, "m": m})
    return st


def section_c():
    print("\n[C] 真代码路径 exec — 用 k.py 里实际的补丁块")
    fc_block, lp_block = _extract_code()

    def run(s):
        ns = {"self": s}
        exec(fc_block, ns)
        return ns["fc_str"], ns["ek_str"]

    # C1 两路都没数据
    s = _Self()
    fc, ek = run(s)
    check(fc == " FC(--)" and ek == " EKF(--)" and not s._log.warns,
          f"无 status/无 EKF ⇒ '{fc}' / '{ek}' 且不告警")

    # C2 正常
    s = _Self()
    s.status = types.SimpleNamespace(arming_state=2, nav_state=14, failsafe=False,
                                    latest_disarming_reason=0)
    s._ekf = (True, True, True, True, False, 0, 0, 0, 0, None)
    fc, ek = run(s)
    check(fc == " FC(a2 n14 fs0 d0 L0)", f"正常: FC 串 = '{fc}' (a2=已解锁 n14=OFFBOARD L0=未落地)")
    check(ek == " EKF(1111 dr0 rst0/0/0/0 dbt=--)", f"正常: EKF 串 = '{ek}'")
    check(not s._log.warns, "正常: 不告警")

    # C3 dist_bottom 有效 ⇒ 显示实测对地距离 (有测距时这就是"真值")
    s = _Self()
    s.status = types.SimpleNamespace(arming_state=2, nav_state=14, failsafe=False,
                                    latest_disarming_reason=0)
    s._ekf = (True, True, True, True, False, 0, 0, 0, 0, 1.234)
    _, ek = run(s)
    check(ek == " EKF(1111 dr0 rst0/0/0/0 dbt=1.23)", f"对地距离有效 ⇒ '{ek}'")

    # C4 板载 px4_msgs 版本可能没有 failsafe/latest_disarming_reason ⇒ 必须兜底不抛
    s = _Self()
    s.status = types.SimpleNamespace(arming_state=1, nav_state=0)
    try:
        fc, _ = run(s)
        check(fc == " FC(a1 n0 fs0 d0 L0)", f"缺字段兜底: '{fc}' (getattr 默认, 不抛异常)")
    except Exception as e:
        check(False, f"缺字段兜底失败: {type(e).__name__}: {e}")

    # C5 EKF 垂向失效 ⇒ WARN 触发, 且 5s 节流
    s = _Self(t=100.0)
    s.status = types.SimpleNamespace(arming_state=2, nav_state=14, failsafe=False,
                                    latest_disarming_reason=0)
    s._ekf = (True, False, True, False, False, 0, 3, 0, 0, None)   # z 无效 + vz 无效
    _, ek = run(s)
    check(" EKF(1010 dr0 rst0/3/0/0 dbt=--)" == ek, f"垂向失效: EKF 串 = '{ek}'")
    check(len(s._log.warns) == 1 and "EKF 垂向估计不可信" in s._log.warns[0]
          and "z_valid=0" in s._log.warns[0] and "z_reset=3" in s._log.warns[0],
          "垂向失效: WARN 触发且含 z_valid/z_reset 与接管提示")
    s.t = 103.0
    run(s); run(s)
    check(len(s._log.warns) == 1, "垂向失效: 3s 内不重复告警 (节流 5s)")
    s.t = 106.0
    run(s)
    check(len(s._log.warns) == 2, "垂向失效: 超过 5s 后再告警一次")

    # C5b landed=True ⇒ FC 串里 L1 (2026-10-09 14:41 实飞的关键信号)
    s = _Self()
    s.status = types.SimpleNamespace(arming_state=2, nav_state=14, failsafe=False,
                                    latest_disarming_reason=0)
    s._ekf = (True, True, True, True, False, 0, 0, 0, 0, None)
    s.landed = True
    fc, _ = run(s)
    check(fc.endswith(" L1)"), f"landed=True ⇒ '{fc}' (L1 = 飞控报已落地)")

    # C6 dead_reckoning ⇒ 同样告警 (纯惯导递推, 高度环必失效)
    s = _Self(t=200.0)
    s.status = types.SimpleNamespace(arming_state=2, nav_state=2, failsafe=True,
                                    latest_disarming_reason=5)
    s._ekf = (True, True, True, True, True, 0, 0, 0, 0, None)
    fc, ek = run(s)
    check(fc == " FC(a2 n2 fs1 d5 L0)", f"飞控侧: '{fc}' (n2=POSCTL fs1=failsafe d5=kill switch)")
    check(len(s._log.warns) == 1 and "dead_reckoning=1" in s._log.warns[0],
          f"dead_reckoning=1 ⇒ 告警: '{ek}'")

    # C7 _cb_local 快照 exec (真实 5 行)
    m = types.SimpleNamespace(x=1.0, y=2.0, z=-3.0, vx=0.1, vy=0.2, vz=-0.3, heading=0.5,
                              xy_valid=True, z_valid=False, v_xy_valid=True, v_z_valid=False,
                              dead_reckoning=True, xy_reset_counter=1, z_reset_counter=2,
                              vxy_reset_counter=3, vz_reset_counter=4,
                              dist_bottom_valid=True, dist_bottom=0.42)
    st = _run_lp(lp_block, m)
    check(st._ekf == (True, False, True, False, True, 1, 2, 3, 4, 0.42),
          f"_cb_local 快照 = {st._ekf}")
    m2 = types.SimpleNamespace(**{**vars(m), "dist_bottom_valid": False, "dist_bottom": 9.9})
    st2 = _run_lp(lp_block, m2)
    check(st2._ekf[9] is None, "对地距离无效 ⇒ None (1Hz 行显示 dbt=--)")


def section_d():
    print("\n[D] 既有字段顺序不动 (FC/EKF 追加在行尾)")
    src = K_PY.read_text(encoding="utf-8")
    ln = [x for x in src.splitlines() if "{fc_str}{ek_str}" in x][0]
    check(ln.index("age={det_age") < ln.index("{extra}") < ln.index("{fc_str}"),
          "顺序: age= → extra(阶段信息) → FC → EKF")
    # 用一趟真实日志行做回归: 既有解析仍匹配
    import json
    logp = pathlib.Path.home() / "fly_flights"
    real = None
    for f in sorted(logp.glob("k_mission_*.log"), reverse=True):
        for line in f.read_text(errors="replace").splitlines():
            if "[t=" in line and "dist_to_target=" in line:
                real = line
                break
        if real:
            break
    if real is None:
        print("  · 跳过: 未找到含 dist_to_target= 的实飞日志行")
        return
    synth = real.replace("dist_to_target=", "dist_to_target=") + " FC(a2 n14 fs0 d0 L0) EKF(1111 dr0 rst0/0/0/0 dbt=--)"
    m = re.search(r"dist_to_target=([\d.]+)m", synth)
    check(m is not None and m.group(1) == re.search(r"dist_to_target=([\d.]+)m", real).group(1),
          f"既有解析 dist_to_target= 仍匹配 (值 {m.group(1) if m else '?'})")
    m2 = re.search(r"NED\(\s*([-\d.]+),\s*([-\d.]+),\s*([-\d.]+)\)", synth)
    check(m2 is not None, "既有解析 NED(..) 仍匹配")
    m3 = re.search(r"vNED=\(([-+\d.]+),([-+\d.]+),([-+\d.]+)\)", synth)
    check(m3 is not None and json.dumps([float(x) for x in m3.groups()]) is not None,
          "既有解析 vNED(..) 仍匹配")
    m4 = re.search(r"age=([\d.\-]+)", synth)
    check(m4 is not None, "既有解析 age= 仍匹配")


