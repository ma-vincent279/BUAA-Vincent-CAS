    # 只读性: 1Hz 追加块内不得出现任何 setpoint 发布或状态机写入
    _fc_only = _block(K_PY.read_text(encoding="utf-8"), FC_MARK,
                      'f"{has_det} age={det_age:4.2f}{extra}{fc_str}{ek_str}")')
    forbid = ("_pub_", "publish", "self.step =", "create_publisher", "self.hold =", "self._target_buckets =")
    hit = [k for k in forbid if k in _fc_only]
    check(not hit, f"1Hz 追加块内无发布/状态机写入 (禁用词 {len(forbid)} 个, 命中 {hit})")
    # _cb_local 快照块: 只允许给 self._ekf 赋值
    _lp_only = _block_lp(K_PY.read_text(encoding="utf-8"))
    assigns = {l.strip().split("=")[0].strip() for l in _lp_only.splitlines()
               if "=" in l and not l.strip().startswith("#")}
