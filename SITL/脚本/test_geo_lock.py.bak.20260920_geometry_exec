def run_lock(seq, anchor):
    """按帧跑身份锁, 返回每帧 (mode, tx, ty, reject_n).

    与真实 DROP 段一致: 'reanchor' 时调用方会把锚点同步更新为新的估计值.
    """
    out, prev, rn = [], None, 0
    for est in seq:
        mode, tx, ty, rn, prev = G(est[0], est[1], anchor[0], anchor[1], GATE,
                                   C['SERVO_EST_WEIGHT'], prev, rn, N, RAD, RMAX)
        if mode == 'reanchor':
            anchor = (est[0], est[1])
        out.append((mode, tx, ty, rn))
    return out


