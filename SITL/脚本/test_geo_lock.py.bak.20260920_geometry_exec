def extract(src, start_re, stop_re):
    """按正则截取一段源码 (从 start_re 行到下一个 stop_re 行之前)."""
    lines = src.split('\n')
    i0 = next(i for i, ln in enumerate(lines) if re.match(start_re, ln))
    i1 = next((i for i in range(i0 + 1, len(lines)) if re.match(stop_re, lines[i])), len(lines))
    return '\n'.join(lines[i0:i1]).rstrip('\n') + '\n'


def load(path):
    src = open(path, encoding='utf-8').read()
    ns = {'math': math}
    exec(extract(src, r'^class PIDController', r'^\S'), ns)
    exec(extract(src, r'^def geo_lock_decide', r'^\S'), ns)
    # 顶层常量: 逐行 exec (含 IMG_W, IMG_H = 640, 360 与 FX = IMG_W/2/... 这类推导式)
    for ln in src.split('\n'):
        if re.match(r'^[A-Z][A-Z0-9_]*(?:\s*,\s*[A-Z][A-Z0-9_]*)*\s*=', ln):
            try:
                exec(ln, ns)
            except Exception:
                pass
    # d 用 DROP_ARRIVE_M(米制), e 仍是 DROP_ARRIVE_PX(像素) —— 两者都可选
    ns['_ARRIVE'] = ns.get('DROP_ARRIVE_M', ns.get('DROP_ARRIVE_PX'))
    missing = [c for c in CONST_NAMES if c not in ns]
    assert not missing, f'{path} 缺少常量 {missing}'
    ns['_SRC_LOCK'] = extract(src, r'^def geo_lock_decide', r'^\S')
    ns['_SRC_PID'] = extract(src, r'^class PIDController', r'^\S')
    # DROP 段积分步长: SITL 每帧 0.05; fly 抽帧 PID_DECIMATION_DROP=5 → dt=0.25
    m = re.search(r'^PID_DECIMATION_DROP\s*=\s*(\d+)', src, re.M)
    ns['_DT'] = (int(m.group(1)) * 0.05) if m else 0.05
    return ns


