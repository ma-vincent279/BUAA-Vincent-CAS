class Roi:
    def __init__(self, cx, cy):
        self.x_offset, self.y_offset = cx - 10.0, cy - 10.0
        self.width, self.height = 20.0, 20.0


def sim(bias_anchor, bias_low, mode, drift=(0.0, 0.0), bucket=(0.25, -0.30)):
    """mode: 'legacy' 或 'new'. 返回 (落点误差 m, 首次 err<DROP_ARRIVE_PX 的 t, 稳定 err, 饱和?)."""
    B = bucket
    A = [B[0] + 0.30, B[1] + 0.30]          # 进 DROP 时飞机停在桶附近
    anchor = (B[0] + bias_anchor[0], B[1] + bias_anchor[1])
    est = (B[0] + bias_low[0], B[1] + bias_low[1])
    pid = ref['PIDController'](C['KP_H'], C['KI_H'], C['KD_H'], C['MAX_HORIZ_VEL'],
                               C['INTEGRAL_LIMIT'], C['DEAD_ZONE_PX'])
    bx, by = 0.0, 0.0
    prev, rn, t_first, sat, err_last, aim_last = None, 0, None, False, 1e9, 0.0
    goal_prev = None
    dt_pid = ENV['SITL/e']['_DT']            # 20Hz 跑控制律 (fly 抽帧不改变等效速率)
    for k in range(FRAMES):
        # 真实像素误差 (由真实几何决定; heading=0 → 机体系: 前=+NED_x, 右=+NED_y)
        ex_true = FX * (B[1] - A[1]) / H     # 横向 (右=东)
        ey_true = FY * (B[0] - A[0]) / H     # 纵向 (前=北)
        roi = Roi(CX + ex_true, CY - ey_true)
        v_fwd, v_lat, err_px, ex, ey = pid.compute(roi, dt_pid, 0.0, 0.0, 0.0, HS)
        # 身份锁 (真实函数)
        lm, lx, ly, rn, prev = G(est[0], est[1], anchor[0], anchor[1], GATE,
                                 C['SERVO_EST_WEIGHT'], prev, rn, N, RAD, RMAX)
        if mode != 'new':
            # 对照组: 都不做像素闭环 —— 只是"锁"的规则不同
            gate = 1.5 if mode == 'wide' else GATE          # wide = 只把身份锁门限扩大到 1.5m
            if mode == 'nolock':                            # nolock = 干脆去掉身份锁, 直接用反投影
                lx, ly = est
            elif math.hypot(est[0] - anchor[0], est[1] - anchor[1]) < gate:
                lx = C['SERVO_EST_WEIGHT'] * est[0] + (1 - C['SERVO_EST_WEIGHT']) * anchor[0]
                ly = C['SERVO_EST_WEIGHT'] * est[1] + (1 - C['SERVO_EST_WEIGHT']) * anchor[1]
            else:
                lx, ly = anchor
            tx, ty = lx, ly
        else:
            # 新逻辑: 重锚定同步更新锚点 + 像素残差积分 (含 height_scale 反除与限幅)
            if lm == 'reanchor':
                anchor = (est[0], est[1]); lx, ly = est
            # 内环瞬时速度 (一阶滞后) → 准静止门控 (2026-09-13 补丁 B)
            v_air = math.hypot(goal_prev[0] - A[0], goal_prev[1] - A[1]) / TAU if goal_prev else 0.0
            if (lm in ('accept', 'reanchor') and err_px * H / FX < C['SERVO_BIAS_ERR_MAX_M']
                    and v_air < C['SERVO_BIAS_VMAX']):
                sc = 1.0 / max(0.5, HS)
                bvf = max(-C['MAX_HORIZ_VEL'], min(C['MAX_HORIZ_VEL'], v_fwd * sc))
                bvl = max(-C['MAX_HORIZ_VEL'], min(C['MAX_HORIZ_VEL'], v_lat * sc))
                bx += bvf * dt_pid
                by += bvl * dt_pid
                bn = math.hypot(bx, by)
                if bn > C['SERVO_BIAS_MAX']:
                    bx *= C['SERVO_BIAS_MAX'] / bn
                    by *= C['SERVO_BIAS_MAX'] / bn
                    sat = True
            tx, ty = lx + bx, ly + by
        # 位置环: 飞机追目标 (一阶滞后) + 未建模稳态偏差
        goal = (tx + drift[0], ty + drift[1])
        goal_prev = goal
        A[0] += (goal[0] - A[0]) * (1 - math.exp(-DT / TAU))
        A[1] += (goal[1] - A[1]) * (1 - math.exp(-DT / TAU))
        if err_px < C['DROP_ARRIVE_PX'] and t_first is None:
            t_first = (k + 1) * DT
        err_last, aim_last = err_px, math.hypot(A[0] - B[0], A[1] - B[1])
    return aim_last, t_first, err_last, math.hypot(bx, by), sat


